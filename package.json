{
  "name": "corporate-domain-registry",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev:web": "npm run dev -w @cdr/web",
    "dev:api": "npm run dev -w @cdr/api",
    "build:web": "npm run export -w @cdr/web",
    "build:api": "npm run build -w @cdr/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint -w @cdr/web"
  }
}
