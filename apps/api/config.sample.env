# The API's settings. Copy to the server as /srv/cdr/cdr.env (root:cdr, 640) and fill in.
# NEVER commit the filled-in copy, paste it into a chat, or print it. Locally, copy it to
# apps/api/cdr.env (gitignored) and start the API with CDR_CONFIG=cdr.env.
# The API re-reads this file when it changes: no restart needed after an edit.

# Stripe: Developers > API keys. sk_test_ while testing, sk_live_ for real payments.
STRIPE_SECRET_KEY=PASTE_STRIPE_SECRET_KEY
# Stripe: Developers > Webhooks > the endpoint https://<site>/api/stripe-webhook/ > Signing secret.
STRIPE_WEBHOOK_SECRET=PASTE_WEBHOOK_SIGNING_SECRET

SITE_URL=https://www.corporatedomainregistry.com
# Where new-order notices go (the client's choice, 27 Sep 2026).
NOTIFY_EMAIL=info@corporatedomainregistry.com
# Sender of every email. Its domain must be verified in Resend.
FROM_EMAIL=no-reply@corporatedomainregistry.com

# resend on the server (DigitalOcean blocks mail ports). file writes <ORDERS_DIR>/outbox/*.eml.
MAIL_TRANSPORT=resend
RESEND_API_KEY=PASTE_RESEND_API_KEY

# Tucows / OpenSRS. test = Horizon (fake money). live needs this server's IP on the account's
# IP Access Rules. Test Stripe with test Tucows, live with live: a mix keeps checkout shut.
OPENSRS_ENV=test
OPENSRS_USERNAME=ubif786
OPENSRS_API_KEY=PASTE_OPENSRS_API_KEY
# Two or more, comma-separated, or empty for the account's defaults (Tucows panel).
OPENSRS_NAMESERVERS=ns1.systemdns.com,ns2.systemdns.com

# Canada pays in CAD at this rate times the USD ladder. 1 = dollar for dollar (client, 28 Sep 2026).
CAD_RATE=1

# Long random strings (for example: openssl rand -hex 24). ADMIN_TOKEN signs in to /api/admin/;
# ORDER_SECRET signs the done page's links; CRON_TOKEN opens /api/cron/.
ADMIN_TOKEN=PASTE_A_LONG_RANDOM_STRING
ORDER_SECRET=PASTE_A_LONG_RANDOM_STRING
CRON_TOKEN=PASTE_A_LONG_RANDOM_STRING

# The orders database (PostgreSQL on the droplet, set up by deploy/droplet/postgres.sh). Over the
# Unix socket as the API's own system user: no password. Locally, for example
# postgresql://cdr@127.0.0.1:5432/cdr (research/tools/shop-tests/run.sh starts a throwaway one).
DATABASE_URL=postgresql://cdr@/cdr?host=/var/run/postgresql

# Outside the web root. Only the "file" mail transport writes here now (outbox/).
ORDERS_DIR=/srv/cdr/cdr-orders
# DB-IP City Lite (npm run geoip -w @cdr/api downloads it). Refresh monthly.
GEOIP_DB=/srv/cdr/geo/dbip-city-lite.mmdb

# Local tests only: a stand-in for Tucows and Stripe. Leave empty on the server.
OPENSRS_URL=
STRIPE_API=https://api.stripe.com/v1
